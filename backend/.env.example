APP_NAME=BISKLET
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FYDA_TIMEOUT=10
FYDA_OIDC_CLIENT_ID=
FYDA_OIDC_AUTHORIZATION_ENDPOINT=
FYDA_OIDC_TOKEN_ENDPOINT=
FYDA_OIDC_USERINFO_ENDPOINT=
FYDA_OIDC_REDIRECT_URI="${APP_URL}/api/v1/auth/fyda/callback"
FYDA_OIDC_PRIVATE_KEY_BASE64=
FYDA_OIDC_CLIENT_ASSERTION_TYPE=urn:ietf:params:oauth:client-assertion-type:jwt-bearer
FYDA_OIDC_CLIENT_ASSERTION_TTL_SECONDS=15
FYDA_OIDC_SCOPE="openid profile email"
FYDA_OIDC_ACR_VALUES=mosip:idp:acr:generated-code
FYDA_OIDC_CLAIMS_LOCALES=en
FYDA_OIDC_PENDING_TTL_SECONDS=600
FYDA_OIDC_RESULT_TTL_SECONDS=300
FYDA_OIDC_SUCCESS_REDIRECT_URL=
FYDA_OIDC_FAILURE_REDIRECT_URL=

RIDE_PRICE_BIRR=10
RIDE_PRICE_MINUTES=20
RIDE_UNLOCK_FEE_BIRR=5

MAPBOX_ACCESS_TOKEN=
MAPBOX_DEFAULT_STYLE=mapbox://styles/mapbox/outdoors-v12
MAPBOX_NAVIGATION_PROFILE=cycling
MAPBOX_SNAP_TO_ROAD=true

GO_GATEWAY_BASE_URL=http://127.0.0.1:9001
GO_GATEWAY_COMMAND_TOKEN=
GO_GATEWAY_WEBHOOK_TOKEN=
GO_GATEWAY_TRACK_INTERVAL_RIDE=120
GO_GATEWAY_TRACK_INTERVAL_MISSING_PHONE=25
GO_GATEWAY_TRACK_MISSING_PHONE_AFTER=60
GO_GATEWAY_TRACK_INTERVAL_PARKED=600
GO_GATEWAY_TRACK_INTERVAL_IDLE=1800
GO_GATEWAY_TRACK_IDLE_AFTER=1800
GO_GATEWAY_TRACK_INTERVAL_ALARM=20
GO_GATEWAY_TRACK_ALARM_BOOST_SECONDS=120
GO_GATEWAY_TRACK_COMMAND_MIN_INTERVAL=30

PAYMENT_WEBHOOK_SECRET=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_WEBHOOK_SECRET=

API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
LOCK_COMMAND_RATE_LIMIT_PER_MINUTE=20
GATEWAY_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
PAYMENT_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
