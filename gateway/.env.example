GATEWAY_ENV=development
TCP_ADDR=:9000
HTTP_ADDR=127.0.0.1:9001
OMNI_OM=OM

# Use independent random secrets containing at least 32 characters.
COMMAND_TOKEN=
LARAVEL_EVENT_WEBHOOK_URL=
LARAVEL_EVENT_WEBHOOK_TOKEN=

# Required in production. Comma-separated provisioned 15-digit IMEIs.
ALLOWED_IMEIS=
# Optional carrier/VPN source networks, for example: 10.20.0.0/16,203.0.113.4/32
ALLOWED_DEVICE_CIDRS=

MAX_FRAME_BYTES=4096
MAX_CONNECTIONS=5000
MAX_CONNECTIONS_PER_IP=500
READ_TIMEOUT_SEC=120
MAX_IDLE_TIMEOUTS=3
WRITE_TIMEOUT_SEC=10
COMMAND_MAX_BODY_BYTES=32768
COMMAND_CLOCK_SKEW_SEC=60

EVENT_SPOOL_DIR=./storage/events
EVENT_SPOOL_MAX_FILES=100000
EVENT_QUEUE_SIZE=1000
EVENT_WORKERS=4
EVENT_RETRIES=3
EVENT_HTTP_TIMEOUT_SEC=5
EVENT_RETRY_DELAY_SEC=1
SHUTDOWN_TIMEOUT_SEC=20
DEBUG_FRAMES=false
